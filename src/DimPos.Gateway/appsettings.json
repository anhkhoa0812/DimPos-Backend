{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "brandApi": {
        "ClusterId": "brandApi",
        "Match": {
          "Path": "/brand/{**catch-all}"
        },
        "Transform": [
          { "PathPattern": "{**catch-all}"}
        ]
      },
      "catalogApi": {
        "ClusterId": "catalogApi",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transform": [
          { "PathPattern": "{**catch-all}"}
        ]
      },
      "identityApi": {
        "ClusterId": "identityApi",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transform": [
          { "PathPattern": "{**catch-all}"}
        ]
      },
      "menuComboApi": {
        "ClusterId": "menuComboApi",
        "Match": {
          "Path": "/menu-comno/{**catch-all}"
        },
        "Transform": [
          { "PathPattern": "{**catch-all}"}
        ]
      },
      "storeApi": {
        "ClusterId": "storeApi",
        "Match": {
          "Path": "/store/{**catch-all}"
        },
        "Transform": [
          { "PathPattern": "{**catch-all}"}
        ]
      }
    },
    "Clusters": {
      "brandApi": {
        "Destinations": {
          "base_destination": {
            "Address": "http://brand-api"
          }
        }
      },
      "catalogApi": {
        "Destinations": {
          "base_destination": {
            "Address": "http://catalog-api"
          }
        }
      },
      "identityApi": {
        "Destinations": {
          "base_destination": {
            "Address": "http://identity-api"
          }
        }
      },
      "menuComboApi": {
        "Destinations": {
          "base_destination": {
            "Address": "http://menu-combo-api"
          }
        }
      },
      "storeApi": {
        "Destinations": {
          "base_destination": {
            "Address": "http://store-api"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
